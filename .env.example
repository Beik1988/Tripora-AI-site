# Server-side only. Configure in Vercel, then redeploy.
# Set CONTACT_DELIVERY=email to deliver directly via Resend.
# Configure a Resend account and authorized sender before enabling.
# CONTACT_EMAIL_TO is the owner's inbox, never the form submitter.
# Keep API keys in Vercel settings; never commit them.
CONTACT_DELIVERY=webhook
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
# Legacy n8n delivery (used only when CONTACT_DELIVERY=webhook):
N8N_WEBHOOK_TEST_URL=
N8N_WEBHOOK_PRODUCTION_URL=

# Production verification:
# 1. Configure email mode and the three email values in Vercel Production.
# 2. Redeploy this commit; submit /contact.html once with a unique test marker.
# 3. Check POST /api/contact returns 200 and the provider records acceptance.
# 4. Confirm the same marker arrives in CONTACT_EMAIL_TO (also check spam).
# API success means provider acceptance, not confirmed inbox delivery.
# This email route does not write to Sheets or HubSpot.
